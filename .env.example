# ==========================================
# AI & JEV 将棋アリーナ 環境変数設定
# ==========================================

# 1. OpenAI (GPT-Luna)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_BASE_URL=https://api.openai.com/v1

# 2. Google Gemini (Gemini3.8flash)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# 3. Anthropic Claude (ClaudeSonnet5)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# 4. TypeSafe AI JEV
TYPESAFE_API_KEY=
# または JEV_API_KEY
JEV_API_KEY=
JEV_MODEL=jev-latest
# 公式 TypeSafe AI (api.typesafe.ai キー) の場合: https://api.typesafe.ai/v1/systemone
# jevtypesafeai.com (jv_live_ キー) の場合: https://jevtypesafeai.com/api/v1/decide
JEV_ENDPOINT=https://jevtypesafeai.com/api/v1/decide

# アプリケーション設定
DATABASE_PATH=shogi_matches.db
MAX_MOVES=256
MOVE_TIMEOUT_SECONDS=60
PORT=8000
